# Local development settings for the backend.
# Copy this file to app/backend/.env and replace placeholder values.
# Do not commit app/backend/.env.

LOCAL_AUTH_SUBJECT=local-developer
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_CONTAINER=inputs
AZURE_COSMOSDB_ACCOUNT=your-cosmos-account
AZURE_COSMOSDB_DATABASE=starter
AZURE_COSMOSDB_CONTAINER=inputs

# Optional overrides
# AZURE_STORAGE_ENDPOINT=https://your-storage-account.blob.core.windows.net
# AZURE_COSMOSDB_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
# MAX_PDF_SIZE_MB=20
# DEFAULT_PAGE_SIZE=20
# MAX_PAGE_SIZE=100
# READINESS_CACHE_SECONDS=30
# LOG_LEVEL=INFO
